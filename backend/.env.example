# Application Environment (local | staging | production)
APP_ENV=local
APP_NAME=Helm Agent Orchestrator
LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,https://helm.vercel.app

# Database Configuration
# Local Dev uses SQLite by default; Production uses Neon Serverless Postgres:
# postgresql+asyncpg://user:password@ep-xyz.region.aws.neon.tech/helm?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./helm_local.db

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# State & Memory (defaults to in-memory store; optionally GCP Firestore if configured)
GCP_PROJECT_ID=
FIRESTORE_COLLECTION=helm_agent_checkpoints
USE_FIRESTORE_EMULATOR=false

# Model Context Protocol (MCP) Configuration
MCP_ENABLED=true
